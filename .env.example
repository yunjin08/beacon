# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the app. Locally with `netlify dev`: http://localhost:8888
NEXTAUTH_URL=http://localhost:8888

# Career-generation backend
NEXT_PUBLIC_BASE_BACKEND_URL=
